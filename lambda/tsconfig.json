{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true
	},
	"include": ["**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
